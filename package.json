{
  "name": "jankirasoi-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production monorepo for Janki Rasoi Tiffin Ordering Platform",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "pnpm --filter @jankirasoi/web build",
    "build:web": "pnpm --filter @jankirasoi/web build",
    "build:admin": "pnpm --filter @jankirasoi/admin build",
    "build:api": "pnpm --filter @jankirasoi/api prisma:generate && pnpm --filter @jankirasoi/api build",
    "start": "pnpm --filter @jankirasoi/web start",
    "start:api": "pnpm --filter @jankirasoi/api start:prod",
    "start:dev": "pnpm --filter ./apps/api start:dev",
    "api:dev": "pnpm --filter ./apps/api start:dev",
    "web:dev": "pnpm --filter ./apps/web dev",
    "admin:dev": "pnpm --filter @jankirasoi/admin dev",
    "start:worker": "pnpm --filter ./apps/api start:worker",
    "postinstall": "pnpm --filter ./apps/api prisma:generate || true",
    "lint": "pnpm --filter ./apps/api lint",
    "test": "pnpm --filter ./apps/api test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "^14.2.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^5.7.3"
  }
}
