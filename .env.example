# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://jankirasoi.in

# Dev-only: set to 'true' to allow X-Simulated-Role bypass in non-production.
# MUST be absent or 'false' in production.
ALLOW_SIMULATED_ROLE=true

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jankirasoi_dev?schema=public"
DATABASE_POOL_SIZE=20
DATABASE_POOL_TIMEOUT=30

# Authentication & Sessions
SESSION_SECRET="super-secret-session-key-must-be-min-32-chars-long"
OTP_ENCRYPTION_SECRET="super-secret-otp-hmac-key-must-be-min-32-chars"

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID="rzp_test_samplekeyid123"
RAZORPAY_KEY_SECRET="samplekeysecret123456"
RAZORPAY_WEBHOOK_SECRET="samplewebhooksecret123456"

# SMS Gateway (MSG91 Indian DLT)
MSG91_AUTH_KEY="sample_msg91_auth_key"
MSG91_SENDER_ID="JNKRAS"
MSG91_DLT_OTP_TE_ID="1207161234567890123"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME="jankirasoi"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="sample_cloudinary_secret"
